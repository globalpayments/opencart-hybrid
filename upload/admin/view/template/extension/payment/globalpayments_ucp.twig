                <label class="col-sm-2 control-label" for="input-sort-order">{{ label_sort_order }}</label>
                <div class="col-sm-10">
                  <input type="text" name="payment_globalpayments_ucp_sort_order" value="{{ payment_globalpayments_ucp_sort_order }}" placeholder="{{ label_sort_order }}" id="input-sort-order" class="form-control" />
                </div>
              </div>
              {% if base_country == 'PL' and base_currency == 'PLN' and payment_globalpayments_ucp_integration_type == "dropin_ui" %}
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-enabled-blik">{{ label_blik }}</label>
                <div class="col-sm-10 checkbox">
                  <label>
                    <input id="input-enabled-blik" type="checkbox" name="payment_globalpayments_ucp_enabled_blik"
                           value="{{ payment_globalpayments_ucp_enabled_blik }}" {% if (payment_globalpayments_ucp_enabled_blik==1) %} checked{% endif %} /> {{ label_blik }}
                  </label>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-enabled-openbanking"> {{ label_open_banking }}</label>
                <div class="col-sm-10 checkbox">
                  <label>
                    <input id="input-enabled-openbanking" type="checkbox" name="payment_globalpayments_ucp_enabled_openbanking"
                           value="{{ payment_globalpayments_ucp_enabled_openbanking }}" {% if (payment_globalpayments_ucp_enabled_openbanking==1) %} checked{% endif %} /> {{ label_open_banking }}
                  </label>
                </div>
              </div>
              {% else %}
              <div class="alert alert-info">
                <i class="fa fa-info-circle"></i> BLIK and Open Banking payment methods are only available for stores with base country set to Poland (PL) and base currency set to PLN.
              </div>
              {% endif %}
            </div>
            <div class="tab-pane" id="tab-payment">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-payment_action">
                  <span data-toggle="tooltip" title="{{ help_payment_action }}">{{ label_payment_action }}</span>
                </label>
                <div class="col-sm-10">
                  <select name="payment_globalpayments_ucp_payment_action" id="input-payment_action" class="form-control">
                    <option value="charge" {{ payment_globalpayments_ucp_payment_action == 'charge' ? 'selected' : '' }}>{{ entry_payment_action_charge }}</option>
                    <option value="authorize" {{ payment_globalpayments_ucp_payment_action == 'authorize' ? 'selected' : '' }}>{{ entry_payment_action_authorize }}</option>
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-allow_card_saving">{{ label_allow_card_saving }}</label>
                <div class="col-sm-10 checkbox">
                  <label>
                    <input id="input-allow_card_saving" type="checkbox" name="payment_globalpayments_ucp_allow_card_saving"
                           value="{{ payment_globalpayments_ucp_allow_card_saving }}"{% if (payment_globalpayments_ucp_allow_card_saving==1) %} checked{% endif %} /> {{ entry_allow_card_saving }}
                  </label>
                  <br/><br/>
                  <p>{{ help_allow_card_saving }}</p>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-txn_descriptor"><span data-toggle="tooltip" title="{{ help_txn_descriptor }}">{{ label_txn_descriptor }}</span></label>
                <div class="col-sm-10">
                  <input id="input-txn_descriptor" type="text" name="payment_globalpayments_ucp_txn_descriptor" value="{{ payment_globalpayments_ucp_txn_descriptor }}" class="form-control" maxlength="25"/><br/>
                  <p>{{ help_txn_descriptor_note }}</p>
                  {% if error_txn_descriptor %}
                    <div class="text-danger">{{ error_txn_descriptor }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
            {{ display_googlepay_tab }}
            {{ display_applepay_tab }}
            {{ display_clicktopay_tab }}
            {{ display_affirm_tab }}
            {{ display_klarna_tab }}
            {{ display_clearpay_tab }}
            {{ display_paypal_tab }}
            {{ display_openbanking_tab }}
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>

(function ($, window) {
  'use strict';

  function GlobalPaymentsUcpAdmin(params) {
    this.baseCountry = params.baseCountry || '';
    this.baseCurrency = params.baseCurrency || '';
    this.userToken   = params.userToken || '';

    this.serviceUrls = {
      global: {
        production: 'https://apis.globalpay.com/ucp',
        sandbox: 'https://apis.sandbox.globalpay.com/ucp'
      },
      europe: {
        production: 'https://apis.eu.globalpay.com/ucp',
        sandbox: 'https://apis.sandbox.eu.globalpay.com/ucp'
      }
    };

    this.init();
  }

  GlobalPaymentsUcpAdmin.prototype = {

    init: function () {
      this.updateServiceUrl();
			this.toggleDCC();
      this.toggleInstallments();
      this.toggleHppWallets();
      this.attachEventHandlers();

      $('#button-credentials-check').trigger('click');
    },


    attachEventHandlers: function () {
      $(document)
        .on('change', '#input-region', this.onRegionChange.bind(this))
        .on('change', '#input-is_production', this.onEnvironmentChange.bind(this))
        .on('change', '#input-integration_type', this.onIntegrationTypeChange.bind(this))
        .on('click', '#button-credentials-check', this.checkCredentials.bind(this))
        .on(
          'change',
          '#input-enabled,' +
          '#input-enable-threeDSecure,' +
          '#input-enable-installments,' +
            '#input-enable-visa-installments,' +
          '#input-debug,' +
          '#input-allow_card_saving,' +
          '#input-is_production,' +
          '#input-enabled-blik,' +
          '#input-enabled-openbanking',
          this.toggleCheckboxValue
        );

        $(document).on('change', '#input-enable-installments, #input-enable-visa-installments', this.toggleInstallments.bind(this));

      $('#input-app_id, #input-app_key').on(
        'input keyup change',
        this.clearLiveAccountName.bind(this)
      );
    },


    onRegionChange: function () {
      this.updateServiceUrl();
      this.resetAccountDropdown('#input-account_name');
      this.resetAccountDropdown('#input-sandbox_account_name');
    },

    onEnvironmentChange: function (event) {
      this.toggleCheckboxValue(event);
      this.toggleCredentialsSettings(event);
      this.updateServiceUrl();
    },

    onIntegrationTypeChange: function () {
			this.toggleDCC();
      this.toggleInstallments();
      this.toggleHppWallets();
    },

    toggleCheckboxValue: function (event) {
      var $el = $(event.target);
      $el.val($el.is(':checked') ? 1 : 0);
    },

    toggleCredentialsSettings: function (event) {
      var isLive = $(event.target).is(':checked');

      this.toggleGroup(
        ['#input-app_id', '#input-app_key', '#input-account_name'],
        isLive
      );

      this.toggleGroup(
        ['#input-sandbox_app_id', '#input-sandbox_app_key', '#input-sandbox_account_name'],
        !isLive
      );
    },

		toggleDCC: function() {
			var integrationType = $('#input-integration_type').val();
			if (integrationType === 'hosted_payment') {
				$('#dcc-form-group').removeClass('hidden');
			} else {
				$('#dcc-form-group').addClass('hidden');
			}
		},

    toggleGroup: function (selectors, show) {
      selectors.forEach(function (selector) {
        $(selector).parents('.form-group').toggleClass('hidden', !show);
      });
    },

    toggleInstallments: function () {
      var integrationType = $('#input-integration_type').val();
      var isMxInstallments = this.baseCountry === 'MX' && this.baseCurrency === 'MXN';
      var isVisaInstallments = (this.baseCountry === 'GB' && this.baseCurrency === 'GBP') || (this.baseCountry === 'CA' && this.baseCurrency === 'CAD');
      var showMxInstallments = integrationType === 'dropin_ui' && isMxInstallments;
      var showVisaInstallments = integrationType === 'dropin_ui' && isVisaInstallments;
      var visaInstallmentsEnabled = $('#input-enable-visa-installments').is(':checked');
      var showVisaInstallmentFields = integrationType === 'dropin_ui' && isVisaInstallments && visaInstallmentsEnabled;

      $('#input-enable-installments')
        .parents('.form-group')
        .toggleClass('hidden', !showMxInstallments);

        $('#input-enable-visa-installments')
          .parents('.form-group')
          .toggleClass('hidden', !showVisaInstallments);

      $('.visa-installments-field').toggleClass('hidden', !showVisaInstallmentFields);

    // Toggle Hpp Installments elements
    let hppInstallmentsEls = [$("[class*=hpp_installments]")] ?? null;
    if( hppInstallmentsEls ) {
      hppInstallmentsEls.forEach((el)=>{
        if(el){
          el.toggleClass('hidden', integrationType === 'dropin_ui');
          }
      })
    }

    },

    toggleHppWallets: function () {
      var integrationType = $('#input-integration_type').val();
      $('#hpp-wallets-group').toggle(integrationType === 'hosted_payment');
    },

    updateServiceUrl: function () {
      var url = this.getServiceUrl().replace(/\/ucp$/, '');
      $('#input-service-url').text(url);
    },

    isLiveMode: function () {
      return $('#input-is_production').is(':checked');
    },

    getRegion: function () {
      return $('#input-region').val() || 'global';
    },

    getEnvironmentName: function () {
      return this.isLiveMode() ? 'production' : 'sandbox';
    },

    getServiceUrl: function () {
      var region = this.getRegion();
      var env = this.getEnvironmentName();
      return this.serviceUrls[region]?.[env] || '';
    },

    getGatewaySetting: function (key) {
      var prefix = this.isLiveMode() ? '' : 'sandbox_';
      return $('#input-' + prefix + key).val().trim();
    },


    resetAccountDropdown: function (selector) {
      $(selector).empty().val('').trigger('change');
    },

    clearLiveAccountName: function () {
      this.resetAccountDropdown('#input-account_name');
    },

    checkCredentials: function () {
      var appId = this.getGatewaySetting('app_id');
      var appKey = this.getGatewaySetting('app_key');

      if (!appId || !appKey) {
        alert("{{ alert_credentials_check }}");
        return;
      }

      var environment = this.isLiveMode() ? 1 : 0;
      var region = this.getRegion();
      var serviceUrl = this.getServiceUrl();
      var self = this;

      $.ajax({
        url:
          'index.php?route=extension/payment/globalpayments_ucp/checkApiCredentials' +
          '&user_token=' + this.userToken,
        type: 'post',
        dataType: 'json',
        data: {
          app_id: appId,
          app_key: appKey,
          environment: environment,
          region: region,
          service_url: serviceUrl
        },
        beforeSend: function () {
          $('#button-credentials-check').button('loading');
          $('.alert:not(".hpp_installments_notice")').remove();
        },
        complete: function () {
          $('#button-credentials-check').button('reset');
        },
        success: function (json) {
          return self.handleCredentialResponse(json, environment);

        }
      });
    },

    handleCredentialResponse: function (json, environment) {

      var selector =
        environment === 1

          ? '#input-account_name'
          : '#input-sandbox_account_name';

      this.resetAccountDropdown(selector);
      //Prevent the account selection from reseting on page load
      let previousSelection = "";
      if($(selector).is("[prevSelected]")){
        previousSelection = $(selector).attr("prevSelected");
      }

      if (json.accountNames) {
        json.accountNames.forEach(function (name) {
          let newOption =  { value: name, text: name };
          if(newOption.value === previousSelection){
            newOption.selected = true;
          }
          $(selector).append($('<option>',newOption));
        });
      }

      if (json.error) {
        this.showAlert('danger', json.error);
        return false;
      }

      if (json.success) {
        this.showAlert('success', json.success);
        return true;
      }
    },


    showAlert: function (type, message) {
      var alertId = 'gp_alert';

      // Remove existing alert
      $('#' + alertId).remove();

      // Insert alert
      $('#table-alert').prepend(
        '<div id="' + alertId + '" class="alert alert-' + type + '">' +
          '<i class="fa fa-info-circle"></i> ' +
          message +
        '</div>'
      );

      // Scroll into view
      var alertEl = document.getElementById(alertId);
      if (alertEl && alertEl.scrollIntoView) {
        alertEl.scrollIntoView(true);
      }
    }
  };

  $(function () {
    new GlobalPaymentsUcpAdmin({
      baseCountry: '{{ base_country }}',
      baseCurrency: '{{ base_currency }}',
      userToken: '{{ user_token }}'
    });
  });

})(jQuery, window);
</script>
{{ footer }}
