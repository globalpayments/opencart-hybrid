<script type="text/javascript">
	function toggleCheckboxValue (event) {
		if ($(event.target).is(':checked')) {
			$(event.target).val(1);
		} else {
			$(event.target).val(0);
		}
	}

    // Service URL mapping based on region and environment
	var serviceUrls = {
		'global': {
			'production': 'https://apis.globalpay.com/ucp',
			'sandbox': 'https://apis.sandbox.globalpay.com/ucp'
		},
		'europe': {
			'production': 'https://apis.eu.globalpay.com/ucp',
			'sandbox': 'https://apis.sandbox.eu.globalpay.com/ucp'
		}
	};

	function updateServiceUrl() {
		var region = $('#input-region').val() || 'global';
		var isProduction = $('#input-is_production').is(':checked');
		var environment = isProduction ? 'production' : 'sandbox';
		var url = serviceUrls[region] ? serviceUrls[region][environment] : '';
		// Remove /ucp suffix for display purposes only
		var displayUrl = url.replace(/\/ucp$/, '');
		$('#input-service-url').text(displayUrl);
	}

  function resetAccountNameDropdown(selector) {
    $(selector).empty();
  }

	$(document).ready(function() {
		// Update service URL on page load
		updateServiceUrl();

		// Update service URL when region changes and clear account name fields
		$('#input-region').on('change', function() {
			updateServiceUrl();
      resetAccountNameDropdown('#input-account_name');
      resetAccountNameDropdown('#input-sandbox_account_name');
		});

		// Update service URL when live mode checkbox changes
		$('#input-is_production').on('change', function() {
			updateServiceUrl();
		});
	});

</script>
